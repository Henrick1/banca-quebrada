{
  "name": "banca-quebrada",
  "version": "0.3.2",
  "private": true,
  "description": "Banca Quebrada: roguelike de dados 3D numa taverna (Three.js + cannon.js)",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "sim": "node tools/simulador.mjs",
    "dist:win": "node build.mjs && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "three": "0.128.0",
    "cannon": "0.6.2"
  },
  "build": {
    "appId": "com.bancaquebrada.jogo",
    "productName": "Banca Quebrada",
    "files": [
      "dist/index.html",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icone.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Banca Quebrada",
      "artifactName": "BancaQuebrada-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BancaQuebrada-Portatil-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Henrick1",
        "repo": "banca-quebrada"
      }
    ]
  },
  "keywords": [
    "roguelike",
    "dados",
    "dice",
    "threejs",
    "jogo",
    "electron"
  ],
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
