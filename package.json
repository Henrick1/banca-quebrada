{
  "name": "banca-quebrada",
  "version": "0.1.0",
  "private": true,
  "description": "Banca Quebrada: roguelike de dados 3D numa taverna (Three.js + cannon.js)",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "sim": "node tools/simulador.mjs",
    "dist:win": "node build.mjs && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bancaquebrada.jogo",
    "productName": "Banca Quebrada",
    "files": [
      "dist/index.html",
      "electron/**"
    ]
  },
  "keywords": [
    "roguelike",
    "dados",
    "dice",
    "threejs",
    "jogo",
    "electron"
  ]
}